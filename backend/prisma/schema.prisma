generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  employees  Employee[]

  @@map("departments")

  tripRequests  TripRequest[]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")

  tripRequests  TripRequest[]
}

model Employee {
  id                 Int      @id @default(autoincrement())
  name               String
  identification     String   @unique
  identificationType String
  position           String
  email              String   @unique
  licenseType        String
  licenseExpiry      DateTime
  licensePhotoFront  String?
  licensePhotoBack   String?
  isBlocked          Boolean  @default(false)
  departmentId       Int
  department         Department @relation(fields: [departmentId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("employees")

  tripRequests  TripRequest[]
}

enum Role {
  SUPER_ADMIN
  ADMIN_TRANSPORT
  ADMIN_DEPARTMENT
  EMPLOYEE
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  plate        String        @unique
  brand        String
  model        String
  year         Int
  color        String
  fuel         FuelType
  mileage      Int           @default(0)
  status       VehicleStatus @default(ACTIVE)
  observations String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("vehicles")

  tripRequests  TripRequest[]
  inspections   Inspection[]
  maintenances  Maintenance[]
}

enum FuelType {
  GASOLINE
  DIESEL
  ELECTRIC
  HYBRID
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Workshop {
  id                  Int            @id @default(autoincrement())
  contractCode        String         @unique
  name                String
  address             String
  specialty           String
  contractExpiry      DateTime
  licitationDocument  String?
  isBlocked           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("workshops")

  maintenances  Maintenance[]
}


model TripRequest {
  id            Int             @id @default(autoincrement())
  departmentId  Int
  department    Department      @relation(fields: [departmentId], references: [id])
  requestedById Int
  requestedBy   User            @relation(fields: [requestedById], references: [id])
  driverId      Int
  driver        Employee        @relation(fields: [driverId], references: [id])
  vehicleId     Int?
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id])
  objective     String
  vehicleType   VehicleType
  destination   String
  departureAt   DateTime
  returnAt      DateTime
  status        TripStatus      @default(PENDING)
  observations  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("trip_requests")

  inspections  Inspection[]
}

enum VehicleType {
  VEHICLE
  MOTORCYCLE
  BUS
}

enum TripStatus {
  PENDING
  APPROVED
  REJECTED
}

model Inspection {
  id              Int            @id @default(autoincrement())
  tripRequestId   Int
  tripRequest     TripRequest    @relation(fields: [tripRequestId], references: [id])
  vehicleId       Int
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id])
  type            InspectionType
  date            DateTime       @default(now())
  mileage         Int
  fuelLevel       FuelLevel
  observations    String?
  mechanicName    String
  mechanicSign    String
  driverSign      String
  items           Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("inspections")
}

model Maintenance {
  id              Int               @id @default(autoincrement())
  vehicleId       Int
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id])
  workshopId      Int
  workshop        Workshop          @relation(fields: [workshopId], references: [id])
  type            MaintenanceType
  maintenanceDate DateTime
  description     String
  mileage         Int
  nextServiceKm   Int?
  amount          Float
  departureDate   DateTime
  returnDate      DateTime?
  problemDetail   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("maintenances")
}

enum InspectionType {
  DEPARTURE
  RETURN
}

enum FuelLevel {
  FULL
  THREE_QUARTERS
  HALF
  ONE_QUARTER
  EMPTY
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}